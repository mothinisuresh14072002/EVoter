# Backend production configuration
# Docker Compose overrides this from the root .env so the Next.js admin proxy and FastAPI share one key.
ADMIN_API_KEY=replace-with-a-long-random-secret
ENABLE_VOTE_MOCK=false
CORS_ORIGINS=http://localhost:3000
MAX_IMAGE_MB=5
SESSION_TTL_SECONDS=300
SESSION_STORE_BACKEND=redis
REDIS_URL=redis://redis:6379/0
MATCH_THRESHOLD=0.85
MANUAL_REVIEW_THRESHOLD=0.70
FACE_DETECTION_MODEL_PATH=backend/models/scrfd_500m.onnx
FACE_EMBEDDING_MODEL_PATH=backend/models/adaface_ir50.onnx
LIVENESS_MODEL_PATH=backend/models/silent_face.onnx
LIVENESS_REAL_CLASS_INDEX=1
LIVENESS_LIVE_THRESHOLD=0.80
LIVENESS_SPOOF_THRESHOLD=0.40
