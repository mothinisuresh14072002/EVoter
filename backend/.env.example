# EVoter Backend Environment Variables
# Copy to .env for development or .env.production for production

# Image upload limits
MAX_IMAGE_MB=5

# Session TTL for ephemeral biometric sessions (seconds)
SESSION_TTL_SECONDS=3600

# Face-matching thresholds
MATCH_THRESHOLD=0.85
MANUAL_REVIEW_THRESHOLD=0.70

# Image quality minimums
MIN_IMAGE_WIDTH=200
MIN_IMAGE_HEIGHT=200

# Computer vision model paths (obtained, licensed, and integrity-checked)
FACE_DETECTION_MODEL_PATH=models/scrfd_500m.onnx
FACE_EMBEDDING_MODEL_PATH=models/adaface_ir50.onnx
LIVENESS_MODEL_PATH=models/silent_face.onnx

# CORS origins allowed to reach the backend (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
