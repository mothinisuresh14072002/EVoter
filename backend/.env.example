# Backend runtime configuration. Do not commit backend/.env.
CORS_ORIGINS=http://localhost:3000
MAX_IMAGE_MB=5
SESSION_TTL_SECONDS=3600
MATCH_THRESHOLD=0.85
MANUAL_REVIEW_THRESHOLD=0.70
MIN_IMAGE_WIDTH=200
MIN_IMAGE_HEIGHT=200

# Required for all /admin routes in deployment. Use a long random secret.
ADMIN_API_KEY=replace-with-a-long-random-secret

# Keep false outside local testing. This endpoint mutates the in-memory tally.
ENABLE_VOTE_MOCK=false

# Mount or provide these model files in production.
FACE_DETECTION_MODEL_PATH=models/scrfd_500m.onnx
FACE_EMBEDDING_MODEL_PATH=models/adaface_ir50.onnx
LIVENESS_MODEL_PATH=models/silent_face.onnx
