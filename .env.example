# EVoter research/demo web application.
# Copy this file to .env for local development or Docker Compose.

# Explicitly enables the non-binding demo login and ballot endpoints.
EVOTER_DEMO_MODE=true

# Required: at least 32 random characters. Use a password manager or:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SIGNING_SECRET=replace-with-a-long-random-session-signing-secret

# Required for /admin sandbox. Use a strong unique password (12+ characters).
ADMIN_UI_PASSWORD=replace-with-a-strong-admin-sandbox-password

# Required for the server-side Next.js -> FastAPI admin proxy.
# Keep this identical to ADMIN_API_KEY in backend/.env.
ADMIN_API_KEY=replace-with-a-long-random-backend-admin-key

# Local Next.js development default. Docker Compose overrides this to http://backend:8000.
BACKEND_INTERNAL_URL=http://localhost:8000
