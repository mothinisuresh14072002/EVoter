# EVoter Production Environment Configuration
# Copy this file to .env.production and fill in real values.
# Do NOT commit the populated .env.production file.

# Frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Backend
MAX_IMAGE_MB=5
SESSION_TTL_SECONDS=1800
MATCH_THRESHOLD=0.85
MANUAL_REVIEW_THRESHOLD=0.70
MIN_IMAGE_WIDTH=320
MIN_IMAGE_HEIGHT=320
FACE_DETECTION_MODEL_PATH=models/scrfd_500m.onnx
FACE_EMBEDDING_MODEL_PATH=models/adaface_ir50.onnx
LIVENESS_MODEL_PATH=models/silent_face.onnx
CORS_ORIGINS=http://localhost:3000
